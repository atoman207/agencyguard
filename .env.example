# Supabase API (template catalog)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Required on Vercel for login (Supabase Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.[ref]:[YOUR_DB_PASSWORD]@aws-0-....pooler.supabase.com:6543/postgres
AGENTGUARD_MASTER_KEY=
AGENTGUARD_PUBLIC_URL=https://your-app.vercel.app

# Sign-in accounts (synced into the DB on each request when seeding is on)
AGENTGUARD_ADMIN_EMAIL=admin@gmail.com
AGENTGUARD_ADMIN_PASSWORD=adminPASSWORD
AGENTGUARD_USER_EMAIL=user@gmail.com
AGENTGUARD_USER_PASSWORD=userPASSWORD
# AGENTGUARD_SEED_ACCOUNTS=true

# Optional local SQLite
# AGENTGUARD_DATA_DIR=.data
# AGENTGUARD_SEED_DEMO=true
