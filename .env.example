# Supabase: holds the template catalog (rule and limit packs).
# Set up once: run supabase/schema.sql in the Supabase SQL editor, then `npm run supabase:seed`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Read-only (row-level security). The running app uses only this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Full access. Used only by `npm run supabase:seed`. Never expose it to a browser.
SUPABASE_SECRET_KEY=sb_secret_...

# AgentGuard
# AGENTGUARD_MASTER_KEY=
# AGENTGUARD_PUBLIC_URL=
# AGENTGUARD_DATA_DIR=.data
# AGENTGUARD_SEED_DEMO=true
