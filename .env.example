# Supabase: run supabase/database.sql once in the SQL editor (app tables +
# template catalog + seed accounts). Then set the keys below.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Read-only (row-level security). The running app uses this for the template catalog.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Full access. Used by `npm run supabase:seed` if you re-seed templates via the API.
# Never expose it to a browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Postgres for app state (users, sessions, agents, events, …).
# Local `npm run dev` can omit this and use SQLite under .data/.
# On Vercel, set the Supabase Transaction pooler URL (port 6543), e.g.:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-....pooler.supabase.com:6543/postgres
# DATABASE_URL=

# AgentGuard
# Required in production (32 random bytes, base64). Do not rely on writing master.key under .data on Vercel.
# AGENTGUARD_MASTER_KEY=
# Public site URL for links in notifications (use your Vercel URL in production).
# AGENTGUARD_PUBLIC_URL=https://your-app.vercel.app
# SQLite directory when DATABASE_URL is unset. Default .data
# AGENTGUARD_DATA_DIR=.data
# Seed demo workspace on first request (dev default on, production default off).
# AGENTGUARD_SEED_DEMO=true
# Keep admin@gmail.com / user@gmail.com sign-in accounts in sync (default on).
# AGENTGUARD_SEED_ACCOUNTS=false
